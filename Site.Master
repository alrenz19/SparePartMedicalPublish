<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="QlyMaint.SiteMaster" %>

<%@ Register Src="~/Admin/ucLogin.ascx" TagPrefix="uc1" TagName="ucLogin" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%: Page.Title %> - Maintenance System</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link href="~/Content/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/fonts/css/font-awesome.min.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/plugins/daterangepicker/daterangepicker-bs3.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/plugins/iCheck/all.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/plugins/colorpicker/bootstrap-colorpicker.min.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/plugins/datepicker/datepicker3.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/plugins/timepicker/bootstrap-timepicker.min.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/plugins/select2/select2.min.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/dist/css/AdminLTE.min.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/dist/css/skins/_all-skins.min.css" rel="stylesheet" type="text/css" runat="server" />
    <link href="~/Content/myCss.css" rel="stylesheet" type="text/css" runat="server" />
    <script src="/Scripts/sweetalert2.all.min.js"></script>

    <style>
        body {
            font-family: 'Emoji';
        }

        .sidebar-menu .active > a {
            background-color: #367fa9 !important;
            color: #fff !important;
        }

        .sidebar-menu .treeview.active > a {
            background-color: #2c3e50 !important;
        }
    </style>
</head>
<body class="skin-blue sidebar-mini sidebar-collapse">
    <form runat="server">
        <asp:ScriptManager runat="server" EnableCdn="true">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>
        <div class="wrapper">
            <!-- Main Header -->
            <header class="main-header">
                <!-- Logo -->
                <a href="~/index.aspx" class="logo" runat="server">
                    <span class="logo-mini"><b>CMMS</b></span>
                    <span class="logo-lg"><b>CMMS</b> Maintenance System</span>
                </a>
                <nav class="navbar navbar-static-top" role="navigation">
                    <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </a>
                    <div class="navbar-custom-menu">
                        <ul class="nav navbar-nav">
                            <li class="dropdown user user-menu">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                    <asp:Image ID="imgUserAvatar" runat="server" CssClass="user-image" ImageUrl="~/Content/dist/img/avatar5.png" alt="User Image" />
                                    <span class="hidden-xs">
                                        <asp:Literal ID="LiteralFullName" runat="server" />
                                    </span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li class="user-header">
                                        <asp:Image ID="imgUserAvatarLarge" runat="server" CssClass="img-circle" ImageUrl="~/Content/dist/img/avatar5.png" alt="User Image" />
                                        <p>
                                            <asp:Literal ID="LiteralFullName2" runat="server" />
                                            <small>
                                                <asp:Literal ID="LiteralDeparmentName" runat="server" />
                                            </small>
                                        </p>
                                    </li>
                                    <li class="user-body"></li>
                                    <li class="user-footer">
                                        <div class="pull-left">
                                            <asp:HyperLink ID="HyperLinkProfile" NavigateUrl="~/UsersPage/profile.aspx" runat="server" CssClass="btn btn-default btn-flat">Profile</asp:HyperLink>
                                        </div>
                                        <div class="pull-right">
                                            <asp:LinkButton ID="btnSignOut" runat="server" CssClass="btn btn-default btn-flat" OnClick="btnSignOut_Click">Sign out</asp:LinkButton>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <a href="#" data-toggle="control-sidebar"><i class="fa fa-gears"></i></a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>

            <!-- Left Sidebar Menu -->
            <aside class="main-sidebar">
                <section class="sidebar">
                    <ul class="sidebar-menu">
                        <li class="header">MAIN NAVIGATION</li>
                        <li class="treeview">
                            <a href="~/index.aspx" runat="server">
                                <i class="fa fa-dashboard"></i><span>Dashboard</span>
                            </a>
                        </li>
                        <li class="treeview">
                            <a href="#">
                                <i class="fa fa-lg fa-fw fa-table"></i><span>Machine &amp; Maintenance</span>
                                <i class="fa fa-angle-left pull-right"></i>
                            </a>
                            <ul class="treeview-menu">
                                <li><a href="~/MachinePage/List.aspx" runat="server"><i class="fa fa-circle-o"></i>Machine Management</a></li>
                                <li><a href="~/Admin/Scheduler" runat="server"><i class="fa fa-circle-o"></i>Maintenance Schedule</a></li>
                            </ul>
                        </li>

                        <li class="treeview">
                            <a href="#">
                                <i class="fa fa-lg fa-fw fa-cogs"></i>
                                <span>Spare Part</span>
                                <i class="fa fa-angle-left pull-right"></i>
                            </a>
                            <ul class="treeview-menu">
                                <li><a href="~/Dashboard/Default.aspx" runat="server"><i class="fa fa-circle-o"></i>Dashboard</a></li>
                                <li><a href="~/Sparepart/SafeStockHistory.aspx" runat="server"><i class="fa fa-circle-o"></i>Safe Stock History</a></li>
                            </ul>
                        </li>
                        <li class="treeview">
                            <a href="#">
                                <i class="fa fa-lg fa-fw fa-pie-chart"></i>
                                <span>Machine Report</span>
                                <i class="fa fa-angle-left pull-right"></i>
                            </a>
                            <ul class="treeview-menu">
                                <li><a href="~/Baocao/DepartmentReport.aspx" runat="server"><i class="fa fa-circle-o"></i>By Department</a></li>
                                <li><a href="~/Baocao/MachineInfo.aspx" runat="server"><i class="fa fa-circle-o"></i>By Machine</a></li>
                            </ul>
                        </li>

                        <li class="treeview">
                            <a href="~/MachineRepair/RepairRequestss/List" runat="server">
                                <i class="fa fa-lg fa-fw fa-briefcase"></i><span>Machine Repair Request</span>
                            </a>
                        </li>

                        <li class="treeview">
                            <a href="~/MaintenanceLeaderPage/List" runat="server">
                                <i class="fa fa-lg fa-fw fa-bullhorn"></i><span>Maintenance Countermeasures</span>
                            </a>
                        </li>
                        
                        <% if (IsManagement)
                           { %>
                        <li class="treeview">
                            <a href="#">
                                <i class="fa fa-circle"></i>
                                <span>Other Management</span>
                                <i class="fa fa-angle-left pull-right"></i>
                            </a>
                            <ul class="treeview-menu">
                                <li><a href="~/Sparepart/Sparepart_Machine" runat="server"><i class="fa fa-circle-o"></i>Link Spare Part vs Machine</a></li>
                                <li><a href="~/Departments/List.aspx" runat="server"><i class="fa fa-circle-o"></i>Departments</a></li>
                                <li><a href="~/UsersPage/List.aspx" runat="server"><i class="fa fa-user"></i>Accounts</a></li>
                                <li><a href="~/MachineGroupPage/List.aspx" runat="server"><i class="fa fa-user"></i>Groups</a></li>
                            </ul>
                        </li>
                        <% } %>
                        
                        <% if (IsManagement)
                           { %>
                        <li class="treeview">
                            <a href="#">
                                <i class="fa fa-cutlery"></i>
                                <span>Tools</span>
                                <i class="fa fa-angle-left pull-right"></i>
                            </a>
                            <ul class="treeview-menu">
                                <li><a href="~/CreateQRCode/CreateQRCode.aspx" runat="server"><i class="fa fa-circle-o"></i>Create QR Code</a></li>
                            </ul>
                        </li>
                        <% } %>
                        
                        <% if (!IsManagement)
                           { %>
                        <li class="treeview">
                            <a href="#" style="color: #ffc107;">
                                <i class="fa fa-lock"></i>
                                <span>Limited Access</span>
                            </a>
                            <ul class="treeview-menu">
                                <li><a href="~/index.aspx"><i class="fa fa-circle-o"></i>Dashboard Only</a></li>
                            </ul>
                        </li>
                        <% } %>
                    </ul>
                </section>
            </aside>

            <!-- Content Wrapper -->
            <div class="content-wrapper" style="min-height: 1066px;">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
        <footer class="main-footer">
            <div class="pull-right hidden-xs">
                <b>Version</b> <%: System.Reflection.Assembly.GetExecutingAssembly().GetName().Version %>
            </div>
            <strong>Copyright &copy; <%= DateTime.Now.Year %> <a href="#">Asahi Intecc Hanoi</a>.</strong> All rights reserved.
        </footer>
    </form>

    <script src="<%=ResolveClientUrl("~/Content/plugins/jQuery/")%>jQuery-2.2.0.min.js"></script>
    <script src="<%= ResolveClientUrl("~/Content/bootstrap/js/") %>bootstrap.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/select2/") %>select2.full.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/input-mask/") %>jquery.inputmask.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/input-mask/") %>jquery.inputmask.date.extensions.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/input-mask/") %>jquery.inputmask.extensions.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/daterangepicker/") %>daterangepicker.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/colorpicker/") %>bootstrap-colorpicker.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/datepicker/") %>bootstrap-datepicker.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/timepicker/") %>bootstrap-timepicker.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/bootstrap-datetimepicker/") %>moment-with-locales.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/bootstrap-datetimepicker/") %>bootstrap-datetimepicker.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/iCheck/") %>icheck.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/plugins/fastclick/") %>fastclick.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/dist/js/") %>app.min.js" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/Content/dist/js/") %>demo.js" type="text/javascript"></script>

    <script>
        $(document).ready(function () {
            var sidebarState = localStorage.getItem('sidebarState');
            if (sidebarState === 'collapsed') {
                $('body').addClass('sidebar-collapse');
            } else {
                $('body').removeClass('sidebar-collapse');
            }

            $('.sidebar-toggle').on('click', function () {
                setTimeout(function () {
                    if ($('body').hasClass('sidebar-collapse')) {
                        localStorage.setItem('sidebarState', 'collapsed');
                    } else {
                        localStorage.setItem('sidebarState', 'expanded');
                    }
                }, 300);
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            var currentPath = window.location.pathname.toLowerCase();
            $('.sidebar-menu a').each(function () {
                var linkPath = $(this).attr('href');
                if (linkPath && linkPath !== '#') {
                    var absolutePath = linkPath.replace('~/', '/').toLowerCase();
                    if (currentPath.indexOf(absolutePath) !== -1) {
                        $(this).parent('li').addClass('active');
                        $(this).closest('.treeview').addClass('active menu-open');
                    }
                }
            });
        });
    </script>
</body>
</html>