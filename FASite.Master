                left: 100%;
                margin-top: -1px;
            }

        span.select2-selection.select2-selection--single {
            height: 40px;
            font-size: medium;
            padding-top: 1%;
            color: cadetblue;
        }

        .styleTagA {
            color: #4c4c4c;
            text-decoration: none;
        }

        .liStyle {
            color: #2f605b !important;
            font: 200 !important;
        }

            .liStyle:hover {
