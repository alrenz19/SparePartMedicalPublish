    <script type="text/javascript">

        $(function () {
            $('.selectSecSit').select2(
                {
                    dropdownParent: $("#HethanModalSIte")
                });
        });

        function ShowMessage(message, messagetype) {
            var cssclass;
            switch (messagetype) {
                case 'Success':
                    cssclass = 'alert-success';
                    break;
                case 'Error':
                    cssclass = 'alert-danger';
                    break;
                case 'Warning':
                    cssclass = 'alert-warning';
                    break;
                default:
                    cssclass = 'alert-info';
            }
            $('#alert_container').append('<div id="alert_div" style="margin: 0 0.5%; -webkit-box-shadow: 3px 4px 6px #999;" class="alert fade in ' + cssclass + '"><a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a><strong>' + messagetype + '!</strong> <span>' + message + '</span></div>');

            setTimeout(function () {
                $("#alert_div").fadeTo(200, 800).slideUp(800, function () {
                    $("#alert_div").remove();
                });
            }, 1200);//5000=5 seconds
        }
        $(document).ready(function () {
            $('.dropdown-submenu a.test').on("click", function (e) {
                $(this).next('ul').toggle();
                e.stopPropagation();
                e.preventDefault();
            });
        });
        function zoomImage(image) {
            // Đặt kích thước hình ảnh lớn hơn
            image.style.transform = "scale(1.5)";
            // Đặt z-index để đảm bảo hình ảnh phía trên
            image.style.zIndex = "1";

            // Tạo một overlay bằng JavaScript
            var overlay = document.createElement("div");
            overlay.style.position = "fixed";
            overlay.style.top = "0";
            overlay.style.left = "0";
            overlay.style.width = "100%";
            overlay.style.height = "100%";
            overlay.style.backgroundColor = "rgba(0, 0, 0, 0.7)";
            overlay.style.display = "flex";
            overlay.style.justifyContent = "center";
            overlay.style.alignItems = "center";

            // Tạo một hình ảnh lớn để hiển thị
            var largeImage = document.createElement("img");
            largeImage.src = image.src;
            largeImage.style.maxWidth = "100%";
            largeImage.style.maxHeight = "100%";

            // Thêm hình ảnh lớn vào overlay
            overlay.appendChild(largeImage);

            // Bắt đầu sự kiện click để đóng hình ảnh phóng to
            overlay.onclick = function () {
                overlay.remove();
                // Đặt lại kích thước và z-index của hình ảnh gốc
                image.style.transform = "scale(1)";
                image.style.zIndex = "0";
            };

            // Thêm overlay vào trang
            document.body.appendChild(overlay);
        }


        $(document).ready(function () {
            $('.navbar-toggle').click(function () {
                $('.navbar-nav').toggleClass('show-nav');
            });
        });
    </script>
</body>
</html>
