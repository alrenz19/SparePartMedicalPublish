    <style>
        body {
            font-family: 'Emoji';
        }

        .modalBackground1 {
            background-color: Black;
            filter: alpha(opacity=40);
            opacity: 0.4;
        }



        .modalmail {
            width: 90%;
            margin-left: 4%;
            padding: 5px;
        }

        .modalmailNested {
            width: 80%;
            margin-left: 4%;
            padding: 5px;
        }

        .overflowHide {
            overflow: hidden;
        }

        .popupmail {
            top: 5% !important;
            width: 80%;
        }

        .lbkDel {
            font-family: cursive;
            font-size: x-large;
            color: #337ab700;
        }

        .btCancelStyle {
            font-family: cursive;
            font-size: x-large;
            color: indianred;
        }

            .btCancelStyle:hover {
                color: red;
                text-decoration: none;
            }

        .lbk:hover .lbkDel {
            color: grey;
            text-decoration: none;
        }

        .lbk:hover .lbl:hover {
            color: red;
            text-decoration: none;
        }

        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu .dropdown-menu {
