<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="CebuMaster.master.cs" Inherits="QlyMain.CebuMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> – EQUIPMENT SPAREPARTS</title>
    <%= QlyMain.Common.AssetHelper.Css("~/Content/bootstrap.min.css") %>
    <%= QlyMain.Common.AssetHelper.Css("~/Content/css/bootstrap-icons.css") %>
    <%= QlyMain.Common.AssetHelper.Css("~/Content/font-awesome.min.css") %>
    <%= QlyMain.Common.AssetHelper.Css("~/Content/css/site.css") %>
    <%-- Web fonts are added by script so they never block the page; the system font shows until they arrive (or if offline). --%>
    <script>
        (function () {
            var l = document.createElement('link');
            l.rel = 'stylesheet';
            l.href = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Source+Sans+3:wght@300;400;600&family=IBM+Plex+Mono:wght@400;500&display=swap';
            document.head.appendChild(l);
        })();
    </script>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="MainForm" runat="server">
        <div class="layout-wrapper">
            <nav class="sidebar">
                <div class="sidebar-logo">
                    <div class="sidebar-logo">
                        <a href='<%= ResolveUrl("~/Index.aspx") %>'
                            style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 10px;">
                            <div class="logo-icon">
                                <i class="bi bi-house"></i>
                            </div>
                            <div class="logo-text">
                                Equipment Spare Parts
                           <span>Back to Main System</span>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="sidebar-nav" style="overflow-y: auto; flex: 1;">
                    <div class="nav-group-label">OVERVIEW</div>
                    <a href='<%= ResolveUrl("~/Dashboard/Default.aspx") %>' class='nav-item <%= IsActive("Dashboard") %>'>
                        <span class="nav-icon"><i class="bi bi-speedometer2"></i></span><span class="nav-label">Dashboard</span></a>
                    
                    <div class="nav-group-label">INVENTORY</div>
                    <a href='<%= ResolveUrl("~/Sparepart/List.aspx") %>' class='nav-item <%= IsActive("Sparepart") %>'>
                        <span class="nav-icon"><i class="bi bi-cpu"></i></span><span class="nav-label">Spare Parts</span></a>
                    
                    <%-- Stock IN - Only visible to RoleId = 3 OR (RoleId = 1 AND UserCode = 011932) --%>
                    <% if (ShowStockIn)
                       { %>
                    <a href='<%= ResolveUrl("~/Stock/StockIn.aspx") %>' class='nav-item <%= IsActive("StockIn") %>'>
                        <span class="nav-icon"><i class="bi bi-box-arrow-in-down"></i></span><span class="nav-label">Stock IN</span></a>
                    <% } %>
                    
                    <a href='<%= ResolveUrl("~/Stock/StockOut.aspx") %>' class='nav-item <%= IsActive("StockOut") %>'>
                        <span class="nav-icon"><i class="bi bi-box-arrow-up"></i></span><span class="nav-label">Stock OUT</span></a>

                    <a href='<%= ResolveUrl("~/Stock/MonthlyInventory.aspx") %>' class='nav-item <%= IsActive("MonthlyInventory") %>'>
                        <span class="nav-icon"><i class="bi bi-clipboard-check"></i></span><span class="nav-label">Monthly Inventory</span></a>
                   
                    <div class="nav-group-label">ORDERING</div>
                    <a href='<%= ResolveUrl("~/Order/List.aspx") %>' class='nav-item <%= IsActive("Order") %>'>
                        <span class="nav-icon"><i class="bi bi-clipboard-check"></i></span><span class="nav-label">Orders</span>
                        <% if (PendingOrders > 0)
                            { %><span class="nav-badge"><%: PendingOrders %></span><% } %></a>

                    <div class="nav-group-label">HISTORY</div>
                    <a href='<%= ResolveUrl("~/AuditTrailPage/InputHistory.aspx") %>' class='nav-item <%= IsActive("InputHistory") %>'>
                        <span class="nav-icon"><i class="bi bi-arrow-down-circle"></i></span><span class="nav-label">Input History</span></a>
                    <a href='<%= ResolveUrl("~/AuditTrailPage/OutputHistory.aspx") %>' class='nav-item <%= IsActive("OutputHistory") %>'>
                        <span class="nav-icon"><i class="bi bi-arrow-up-circle"></i></span><span class="nav-label">Output History</span></a>

                    <% if (IsAdmin)
                        { %>
                    <div class="nav-group-label">ADMIN</div>
                    <a href='<%= ResolveUrl("~/Admin/Users.aspx") %>' class='nav-item <%= IsActive("Admin") %>'>
                        <span class="nav-icon"><i class="bi bi-people"></i></span><span class="nav-label">Users</span></a>
                    <% } %>
                </div>

            </nav>
            <div class="main-wrapper">
                <header class="topbar">
                    <div class="topbar-title">
                        <asp:Literal ID="litPageTitle" runat="server" />
                        <span>
                            <asp:Literal ID="litBreadcrumb" runat="server" /></span>
                    </div>
                    <div class="topbar-actions">
                        <span class="topbar-clock" id="clockDisplay"></span>
                        <asp:ContentPlaceHolder ID="TopbarActions" runat="server" />
                    </div>
                </header>
                <main class="page-content">
                    <asp:Panel ID="pnlQuickNav" runat="server" CssClass="quick-nav-bar">
                        <a href='<%= ResolveUrl("~/Dashboard/Default.aspx") %>' class="quick-nav-btn">
                            <i class="fa-solid fa-house"></i>Dashboard
                        </a>
                        <span class="quick-nav-sep">|</span>
                        <a href='<%= ResolveUrl("~/Sparepart/List.aspx") %>' class="quick-nav-btn">
                            <i class="fa-solid fa-house"></i>Sparepart List
                        </a>
                        <span class="quick-nav-sep">|</span>
                        <asp:Panel ID="pnlBackBtn" runat="server">
                            <a href="javascript:history.back()" class="quick-nav-btn"
                                title="Back to previous page ">
                                <i class="fa-solid fa-arrow-left"></i>
                                <asp:Literal ID="litBackLabel" runat="server" Text="Back" />
                            </a>
                        </asp:Panel>
                        <asp:ContentPlaceHolder ID="BreadcrumbExtra" runat="server" />
                    </asp:Panel>
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
                <footer style="padding: 10px 24px; font-size: 12px; color: var(--text-muted); border-top: 1px solid var(--border); background: #fff;">
                    CEBU Spare Part Management v2.0 &copy; <%: DateTime.Now.Year %>
                </footer>
            </div>
        </div>
    </form>
    <%-- Bootstrap 3 JS to match bootstrap.min.css (3.4.1); the Bootstrap 5 bundle was also loaded here but nothing used it. --%>
    <script src="<%= QlyMain.Common.AssetHelper.Url("~/Scripts/jquery-3.4.1.min.js") %>" type="text/javascript"></script>
    <script src="<%= QlyMain.Common.AssetHelper.Url("~/Content/bootstrap/js/bootstrap.min.js") %>" type="text/javascript"></script>
    <script>
        (function tick() {
            var n = new Date(), p = function (x) { return String(x).padStart(2, '0') }, el = document.getElementById('clockDisplay');
            if (el) el.textContent = p(n.getHours()) + ':' + p(n.getMinutes()) + ':' + p(n.getSeconds()) + '  ' + p(n.getDate()) + '/' + p(n.getMonth() + 1) + '/' + n.getFullYear();
            setTimeout(tick, 1000);
        })();
    </script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>